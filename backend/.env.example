# Copy to backend/.env and fill in. Never commit .env.

# --- YouCam AI Skin Analysis ----------------------------------------------
# Create a key at https://yce.makeupar.com/api-console/en/api-keys/
# (use the hackathon organisers' India registration guidance if it differs).
YOUCAM_API_KEY=
# Documented API host for the S2S v2.0 endpoints.
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com
# sd: photo short side >= 480px.  hd: short side >= 1080px.
# Scans from different modes are never compared with each other.
YOUCAM_MODE=sd
YOUCAM_POLL_INTERVAL_S=2.5
YOUCAM_TIMEOUT_S=120

# When no key is set, return YouCam's published documentation sample so the UI
# can be developed. Every such scan is labelled "Development fixture".
# This is never used as a fallback when a live request fails.
DEV_FIXTURE_ENABLED=true

# Keep a copy of each provider response with all URLs removed, for debugging.
STORE_REDACTED_RAW_RESPONSE=true

# --- Optional: language model for the companion's phrasing ----------------
# Answers and safety rules stay deterministic; the model only rephrases them.
ANTHROPIC_API_KEY=
ASSISTANT_LLM_MODEL=claude-sonnet-5-5

# --- App --------------------------------------------------------------------
# DATABASE_URL=sqlite:///./dermatrack.db
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
